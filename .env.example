# Config to launch full application stack using Docker Compose.
# Copy this file to .env and specify required values.

# Profiles for running Docker Compose services separately.
# Possible values: dev;
COMPOSE_PROFILES=dev

# --- Postgres ---
POSTGRES_PORT=5432
# POSTGRES_USER is an admin role
# and is not used by any application.
POSTGRES_USER=admin
POSTGRES_PASSWORD=

# --- Backend ---
BACKEND_PORT=8000
BACKEND_DB_NAME=backend
BACKEND_DB_USER=backend
BACKEND_DB_PASSWORD=
BACKEND_LOG_LEVEL=INFO
# Leave empty to disable notifications about new requests.
# Must be specified or unspecified simultaneously.
BACKEND_TG_BOT_TOKEN=
BACKEND_TG_CHAT_ID=
# Secret key used to verify captcha tokens of new requests.
# Cloudflare test keys (accept any token):
#   1x0000000000000000000000000000000AA - always passes
#   2x0000000000000000000000000000000AA - always fails
BACKEND_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Frontend ---
FRONTEND_PORT=3000

# --- CMS ---
CMS_DB_NAME=cms
CMS_DB_USER=cms
CMS_DB_PASSWORD=
CMS_SECRET=
# Leave emply to create account using UI.
# Changing this values doesn't affect existing account.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# --- RustFS ---
# Only for development
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_BUCKET=assets
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=

# --- S3 ---
# Specify this variables for production
# and leave RustFS variables empty.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
