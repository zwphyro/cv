# Config to launch backend locally.
# Copy this file to .env and specify required values.

# --- Postgres ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_DB_NAME=backend
BACKEND_DB_USER=backend
BACKEND_DB_PASSWORD=
BACKEND_LOG_LEVEL=INFO

# --- Telegram ---
# Leave empty to disable notifications about new requests.
# Must be specified or unspecified simultaneously.
BACKEND_TG_BOT_TOKEN=
BACKEND_TG_CHAT_ID=
