# Config to launch frontend locally.
# Copy this file to .env and specify required values.

# --- Postgres ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- CMS ---
CMS_DB_NAME=cms
CMS_DB_USER=cms
CMS_DB_PASSWORD=
CMS_SECRET=
# Leave emply to create account using UI.
# Changing this values doesn't affect existing account.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# --- S3 ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
