# Config to launch frontend locally.
# Copy this file to .env and specify required values.

# --- Frontend ---
# Public address of the site, e.g. https://example.com
FRONTEND_PUBLIC_URL=
# true lets search engines index the site, production only
FRONTEND_INDEXING_ENABLED=false

# --- CMS ---
CMS_DB_NAME=cms
CMS_DB_USER=cms
CMS_DB_PASSWORD=
CMS_SECRET=
# Leave emply to create account using UI.
# Changing this values doesn't affect existing account.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
# true overwrites the site and homepage content with apps/frontend/seed on start.
CMS_SEED_ENABLED=false

# --- Backend ---
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# --- Postgres ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- S3 ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Turnstile ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA
